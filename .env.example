# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Production Server Configuration
PORT=3000

# PostgreSQL Database Connection String (e.g. on Render, Neon, Supabase, Cloud SQL)
# Leave empty for automatic in-process persistent storage fallback
DATABASE_URL=postgres://user:password@hostname:5432/smart_campus_bus

# JSON Web Token Secret for authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Allowed CORS Origin for separate frontend deployment (e.g. Vercel)
# In production, do NOT use '*'. Specify your exact frontend domain(s) comma-separated.
CORS_ORIGIN=https://your-frontend.vercel.app

# Client-Side API & WebSocket URLs (for Vercel deployment pointing to Render backend)
# When deployed together in full-stack container, defaults to window.location.origin
VITE_API_URL=
VITE_SOCKET_URL=
