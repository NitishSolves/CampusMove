# CampusMove Environment Variables
# Copy this file to .env and fill in the values

# ============================================
# REQUIRED: Database
# ============================================
# PostgreSQL connection string (leave empty for in-process file-based storage fallback)
DATABASE_URL=postgres://user:password@host:5432/campusmove

# ============================================
# REQUIRED: Authentication
# ============================================
# JWT secret - use a strong random string (min 32 characters)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_change_this_in_production

# ============================================
# REQUIRED: Map Provider
# ============================================
# The app uses Leaflet with CartoDB tiles by default (no API key needed).
# For Google Maps or premium tiles, you can configure additional providers.

# ============================================
# OPTIONAL: Deployment URLs
# ============================================
# App base URL (used for self-referential links and OAuth callbacks)
APP_URL=http://localhost:3000

# Frontend API base URL (if separate from backend)
# Leave empty for same-origin deployment
VITE_API_URL=

# Frontend WebSocket URL (if separate from backend)
# Leave empty for same-origin deployment
VITE_SOCKET_URL=

# ============================================
# OPTIONAL: CORS
# ============================================
# Allowed origins (comma-separated). In production, specify exact domains.
# Do NOT use '*' in production.
CORS_ORIGIN=http://localhost:5173

# ============================================
# OPTIONAL: Server
# ============================================
PORT=3000
NODE_ENV=development

# ============================================
# OPTIONAL: AI features
# ============================================
# Google Gemini API key (for AI-powered features if enabled)
GEMINI_API_KEY=
